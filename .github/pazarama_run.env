# Pazarama satıcı/ürün toplama — bu dosya değişip marketfiyati-gecmis dalına gönderilince iş akışı çalışır.
# AŞAMA 1 (deneme): SHARD_LIST=[1], MAX_MINUTES=8  →  AŞAMA 2 (tam): SHARD_LIST=[1..40 dizisi], MAX_MINUTES=120
# SHARDS: toplam pay sayısı (sitemap bu kadar parçaya bölünür) · RPS_SECONDS: makine başına istekler arası saniye
# 40 makine × 1 istek/6 sn ≈ 7 istek/sn toplam (Market Fiyatı koşusuyla aynı mertebe).
# Çıktı ŞİFRELİDİR (age): depo herkese açık olduğu için artifact'lar yalnız genel anahtarla şifrelenir;
# özel anahtar yerelde (~/.config/geoprop/pazarama_age.key), depoya girmez.
SHARDS=40
SHARD_LIST=[1]
RPS_SECONDS=6
MAX_MINUTES=8
STOP_AFTER_BLOCKS=25
RUN_DATE=2026-10-03
AGE_PUBKEY=age1u8c2cyc4e45km89qp5pnvt3yypndgcqyxxf5qh2rmqvzez0kkf3qmqptqd
RUN=2
