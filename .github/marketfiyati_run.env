# Market Fiyatı şube katalogları — bu dosya değişip bu dala gönderilince iş akışı çalışır.
# ROUNDS: 1 = her ilçe×zincirden bir şube (4.047), 2 = kalan şubeler (10.744)
# SHARDS: makine sayısı; LIMIT: makine başına en çok şube (0 = sınırsız; deneme için küçük sayı)
# RPS: makine başına saniyedeki istek; MAX_MINUTES: iş 6 saat sınırına takılmadan temiz durur
ROUNDS=1,2
SHARDS=40
LIMIT=0
RPS=1
MAX_MINUTES=330
RUN=4
